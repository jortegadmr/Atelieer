{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier v2",
  "version": "2.0.0",
  "identifier": "com.jortegadmr.atelier-v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atelier v2",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "category": "Productivity",
    "shortDescription": "Pizarra de tramas para series",
    "longDescription": "Atelier v2: desarrollar una serie de lo general a lo particular (serie, tramas, temporada y episodios) y pasar lo maduro a la wiki de Obsidian.",
    "copyright": "jortegadmr",
    "publisher": "jortegadmr",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
